+                        f"row={row_index}, stored={stored_len}, prompt={prompt_len}, "
+                        f"response={response_len}, response_width={response_width}"
+                    )
+                valid_rows.append(row[left_prompt_padding:valid_end])
+            return torch.cat(valid_rows, dim=0)
