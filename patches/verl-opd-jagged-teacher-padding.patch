+        def _remove_teacher_padding(tensor: torch.Tensor) -> torch.Tensor:
+            rows = tensor.unbind(0)
+            if len(rows) != len(prompt_lens):
+                raise ValueError(
+                    f"Teacher tensor batch size {len(rows)} does not match input batch size {len(prompt_lens)}"
